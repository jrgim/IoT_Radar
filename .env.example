# = MQTT broker
MQTT_HOST=        # IP o hostname de tu broker (ej: 192.168.1.10)
MQTT_PORT=1883    # 1883 sin TLS, 8883 con TLS
MQTT_USER=
MQTT_PASSWORD=


# = Zigbee2MQTT
# Prefijo de topics configurado en Zigbee2MQTT (ajustar si se ha cambiado)
Z2M_TOPIC_PREFIX=zigbee2mqtt


# = Escáner de red
# Intervalo entre escaneos LAN, en MINUTOS (igual que scan_interval_minutes en config.yaml). 
# Para desarrollo usar 1; en producción 60.
SCAN_INTERVAL=60

# API key de NVD para consultas CVE (opcional).
# Sin key: límite 5 req/30s. Con key: 100 req/30s.
# Registro en: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=


# = Notificaciones Home Assistant
# Servicio de notificación para alertas CRITICAL/HIGH (ej: notify.mobile_app_mi_telefono)
ALERT_NOTIFY_SERVICE=notify

# Token del Supervisor de HA (inyectado automáticamente en producción).
# En desarrollo: cualquier valor distinto de "fake_token_for_dev" activa llamadas reales.
# Deja el valor de ejemplo para modo dev (solo logs, sin llamadas al Supervisor).
SUPERVISOR_TOKEN=fake_token_for_dev


# = Servidor web
# Puerto del dashboard. En producción HA Ingress gestiona el acceso externo.
INGRESS_PORT=8099
# Ruta del fichero SQLite. En producción HA monta /data como volumen persistente.
DB_PATH=/data/database.db
